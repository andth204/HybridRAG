# Production environment template.
# Copy to `.env.prod` and inject real secrets via your secret manager. Loaded automatically when APP_ENV=prod.

# -----< OpenAI & LLM >-----
OPENAI_API_KEY=<REPLACE_ME>
GENERATE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
TEMPERATURE_MAIN=0.6
TEMPERATURE_CHITCHAT=0.8
MAX_GEN_MAIN=500
MAX_GEN_CHITCHAT=100

# -----< Chunking >-----
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=100

# -----< Retrieval/ Reranker >-----
VECTOR_SEARCH_K=8
ELASTIC_SEARCH_K=8
RRF_K=60
FUSION_K=10

RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
USE_RERANKER=True
RERANK_TOP_K=4

# -----< Query Rewriting >-----
REWRITER_MODEL=gpt-4o-mini
K_REWRITE=8
MAX_HISTORY_TOKENS_REWRITE=250
TEMPERATURE_REWRITER=0.2
REWRITER_TIMEOUT=2.5
MAX_REWRITE_OUTPUT_TOKENS=100
MAX_HISTORY_CHARS_REWRITE=1200
REWRITER_CACHE_SIZE=512
REWRITER_CACHE_TTL_SECONDS=86400


# -----< Kafka >-----
KAFKA_BOOTSTRAP_SERVERS=<prod-kafka-bootstrap:9092>
INDEXING_INPUT_TOPIC=minio-file-events
INDEXING_STATUS_TOPIC=minio-file-status
INDEXING_CONSUMER_GROUP=indexing-group-prod
INDEXING_BATCH_SIZE=10
INDEXING_BATCH_INTERVAL=2

# -----< Postgres >-----
POSTGRES_HOST=<prod-pg-host>
POSTGRES_PORT=5432
POSTGRES_DB=utehy
POSTGRES_USER=<REPLACE_ME>
POSTGRES_PASSWORD=<REPLACE_ME>

# -----< MinIO >-----
MINIO_ENDPOINT=<prod-minio-url>
MINIO_ROOT_USER=<REPLACE_ME>
MINIO_ROOT_PASSWORD=<REPLACE_ME>
MINIO_ACCESS_KEY=<REPLACE_ME>
MINIO_SECRET_KEY=<REPLACE_ME>
MINIO_SECURE=True
MINIO_BUCKET_NAME=utehy

# ------< Index State (Postgres table) >-----
INDEX_STATE_SCHEMA=public
INDEX_STATE_TABLE=file_index_state


# -----< Store Cache >-----
BM25_CACHE_DIR=./data/vector_store/bm25_store
FAISS_CACHE_DIR=./data/vector_store/faiss_store

# -----< Google OAuth >-----
GOOGLE_CLIENT_ID=<REPLACE_ME>
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_REQUIRE_VERIFIED_EMAIL=True
GOOGLE_ALLOWED_HD=<allowed-google-workspace-domain>
