# Development environment template.
# Copy to `.env.dev` and fill in real values. Loaded automatically when APP_ENV=dev.

# -----< OpenAI & LLM >-----
OPENAI_API_KEY=
GENERATE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
TEMPERATURE_MAIN=0.6
TEMPERATURE_CHITCHAT=0.8
MAX_GEN_MAIN=500
MAX_GEN_CHITCHAT=100

# -----< Chunking >-----
FIXED_CHUNK_SIZE=800
FIXED_CHUNK_OVERLAP=100

# -----< Retrieval/ Reranker >-----
VECTOR_SEARCH_K=8
ELASTIC_SEARCH_K=8
RRF_K=60
FUSION_K=10

RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
USE_RERANKER=False
RERANK_TOP_K=4

# -----< Query Rewriting >-----
REWRITER_MODEL=gpt-4o-mini
K_REWRITE=8
MAX_HISTORY_TOKENS_REWRITE=250
TEMPERATURE_REWRITER=0.2
REWRITER_TIMEOUT=2.5
MAX_REWRITE_OUTPUT_TOKENS=100
MAX_HISTORY_CHARS_REWRITE=1200
REWRITER_CACHE_SIZE=512
REWRITER_CACHE_TTL_SECONDS=86400


# -----< Kafka >-----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INDEXING_INPUT_TOPIC=minio-file-events
INDEXING_STATUS_TOPIC=minio-file-status
INDEXING_CONSUMER_GROUP=indexing-group-dev
INDEXING_BATCH_SIZE=10
INDEXING_BATCH_INTERVAL=2

# -----< Postgres >-----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=utehy_dev
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# -----< MinIO >-----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin12345
MINIO_SECURE=False
MINIO_BUCKET_NAME=utehy-dev

# ------< Index State (Postgres table) >-----
INDEX_STATE_SCHEMA=public
INDEX_STATE_TABLE=file_index_state


# -----< Store Cache >-----
BM25_CACHE_DIR=./data/vector_store/bm25_store
FAISS_CACHE_DIR=./data/vector_store/faiss_store

# -----< Google OAuth >-----
GOOGLE_CLIENT_ID=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_REQUIRE_VERIFIED_EMAIL=False
GOOGLE_ALLOWED_HD=
